# Engine internals, held back from the public tree.
# Every layer's interface (its __init__.py) stays published, together with the
# primitives (core, cartridge), container inference (L0), the classical
# estimators (L3), the standard DSP and coding blocks, the web API and the GUI.
/shruti/pipeline.py
/shruti/selftest.py
/shruti/l1_receiver/artefacts.py
/shruti/l2_detect/detect.py
/shruti/l4_twin/chain.py
/shruti/l4_twin/channel.py
/shruti/l4_twin/ssb.py
/shruti/l4b_peel/peel.py
